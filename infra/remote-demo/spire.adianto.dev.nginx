# Browser edge only; Money's SPIFFE TLS still terminates inside Go Money.
server {
    listen 80;
    listen [::]:80;
    server_name spire.adianto.dev;
    access_log off;
    error_log /dev/null crit;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/spire-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://spire.adianto.dev$request_uri; }
}
server {
    listen 127.0.0.1:8444 ssl;
    http2 on;
    server_name spire.adianto.dev;
    ssl_certificate /etc/letsencrypt/live/spire.adianto.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/spire.adianto.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 2k;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    location / {
        proxy_pass https://127.0.0.1:18087;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_ssl_server_name on;
        proxy_ssl_name spire.adianto.dev;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 4;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_connect_timeout 3s;
    }
}
