process.roles=broker,controller
node.id=1
controller.quorum.voters=1@kafka:9094
controller.listener.names=CONTROLLER
listeners=BROKER://:9093,CONTROLLER://:9094
advertised.listeners=BROKER://kafka:9093
listener.security.protocol.map=BROKER:SSL,CONTROLLER:SSL
inter.broker.listener.name=BROKER
log.dirs=/var/lib/kafka/data
num.partitions=1
default.replication.factor=1
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1
min.insync.replicas=1
auto.create.topics.enable=false
authorizer.class.name=org.apache.kafka.metadata.authorizer.StandardAuthorizer
allow.everyone.if.no.acl.found=false
super.users=User:CN=kafka-broker;User:CN=kafka-admin
ssl.protocol=TLSv1.3
ssl.enabled.protocols=TLSv1.3
ssl.client.auth=required
ssl.endpoint.identification.algorithm=https
ssl.keystore.type=PEM
ssl.keystore.location=/pki/broker.pem
ssl.truststore.type=PEM
ssl.truststore.location=/pki/ca.pem
message.max.bytes=65536
socket.request.max.bytes=131072
replica.fetch.max.bytes=131072
log.retention.ms=3600000
log.segment.bytes=1048576
group.initial.rebalance.delay.ms=0
